# Демонстрационные настройки OnlineDeanery.
# Значения паролей ниже предназначены только для локального демо; перед реальным
# развертыванием замените их на уникальные секреты.

# Frontend API URL, передаваемый Docker Compose при сборке frontend.
VITE_API_URL=https://fancifully-formidable-greenshank.cloudpub.ru

# Адреса frontend, которым backend разрешает обращаться к API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://deanery.forestinc.ru,https://markedly-rare-basset.cloudpub.ru

# OCR and document-extraction services (входят в репозиторий: ml1, ml2).
# Эти defaults ожидают их на хосте/в compose на портах 8001 и 8003.
ML1_URL=http://host.docker.internal:8001/ocr
ML2_URL=http://host.docker.internal:8003/extract

# PaddleOCR-VL endpoint для ml1. По умолчанию compose-сервис llama.
PADDLEOCR_VL_URL=http://llama:8080/v1/chat/completions
PADDLEOCR_VL_TIMEOUT=180
# 1 — старый llama-server (b8110, требует <__media__>); 0 — актуальный (>=ad19f21, b11429/v0.6.0, docker-образ llama).
PADDLEOCR_VL_LEGACY_MEDIA=0
# Для host-режима (llama-server.exe рядом): http://host.docker.internal:8080/v1/chat/completions
# llama.cpp CPU threads: -1 = automatic use of available CPU threads; set a positive number to tune.
LLAMA_THREADS=-1

# Путь к YOLOv8-ONNX внутри контейнера ml1 (папка ./models смонтирована в /models).
# Подпись: Mels22 YOLO11s 4cls, экспорт командой из models/README.md.
YOLO_SIG_MODEL_PATH=/models/signature.onnx
# YOLO_MODEL_PATH=      — печать своей YOLOv8n, если обучите (иначе классика синего кольца)
# YOLO_CONFIDENCE=0.4
# ONNX Runtime intra-op CPU threads for the signature/stamp detector; 0 = automatic.
# YOLO_INTRA_OP_THREADS=0
# YOLO_STAMP_HEURISTIC=1 — классический поиск печати при отсутствии YOLO_MODEL_PATH (0 — выкл)
YOLO_STAMP_HEURISTIC=1
# Backend 2: путь к Положению (JSON по схеме backend/data/rules.json).
# RULES_PATH=./backend/data/rules.json
# Backend 2: опциональный LLM-селектор evidence (только выбор clause/field ID).
# ANSWER_LLM_URL=
# ANSWER_LLM_MODEL=
# ANSWER_LLM_TIMEOUT=8
# ANSWER_LLM_MAX_TOKENS=256
# ML2: опциональная LLM-правка OCR-полей (пусто = выкл, fallback regex).
# LLM_URL=
# LLM_TIMEOUT=12
# API: таймаут внутренних запросов (с), хватает на два прохода OCR.
INTERNAL_TIMEOUT=300

# DB (compose). Демо-пароль соответствует демо-окружению; не используйте его в production.
# DATABASE_URL собирается автоматически; для отдельного URL пароль должен быть URL-кодирован.
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_password
POSTGRES_DB=deanery

# Bootstrap-администратор создаётся при первом запуске, если пользователя ещё нет.
# Пароль должен содержать от 8 до 256 символов.
BOOTSTRAP_ADMIN_EMAIL=admin@university.ru
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Алексей Админов

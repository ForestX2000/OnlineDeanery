# OCR and document-extraction services (входят в репозиторий: ml1, ml2).
# Эти defaults ожидают их на хосте/в compose на портах 8001 и 8003.
ML1_URL=http://host.docker.internal:8001/ocr
ML2_URL=http://host.docker.internal:8003/extract
# 1 — старый llama-server (b8110, требует <__media__>); 0 — актуальный (>=ad19f21).
PADDLEOCR_VL_LEGACY_MEDIA=1
# PaddleOCR-VL endpoint для ml1 (llama-server OpenAI-совместимый).
# PADDLEOCR_VL_URL=http://host.docker.internal:8080/v1/chat/completions
# PADDLEOCR_VL_TIMEOUT=120
# Путь к YOLOv8-ONNX (signature/stamp) внутри контейнера ml1 или на хосте.
# Пусто = детектор отключён, signature/stamp = null («проверка не выполнена»).
# YOLO_MODEL_PATH=      — печать (собственная YOLOv8n: StaVer + синтетика)
# YOLO_SIG_MODEL_PATH=  — подпись (Mels22 YOLO11s 4cls, экспорт 640: conf 0.57 на baton.png)
# YOLO_CONFIDENCE=0.4
# Backend 2: путь к Положению (JSON по схеме backend/data/rules.json).
# RULES_PATH=./backend/data/rules.json
# Backend 2: опциональный LLM-селектор evidence (только выбор clause/field ID).
# ANSWER_LLM_URL=
# ANSWER_LLM_MODEL=
# ANSWER_LLM_TIMEOUT=8
# ANSWER_LLM_MAX_TOKENS=256
# ML2: опциональная LLM-правка OCR-полей (пусто = выкл, fallback regex).
# LLM_URL=
# LLM_TIMEOUT=12
# API: таймаут внутренних запросов (c), по умолчанию 60.
# INTERNAL_TIMEOUT=60
# DB (compose): задайте в .env, не храните реальные пароли в репо.
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=deanery

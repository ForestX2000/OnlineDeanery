# OCR and document-extraction services (not included in this repository).
# These defaults expect them to be running on the host at ports 8001 and 8003.
ML1_URL=http://host.docker.internal:8001/ocr
ML2_URL=http://host.docker.internal:8003/extract
# 1 — старый llama-server (b8110, требует <__media__>); 0 — актуальный (>=ad19f21).
PADDLEOCR_VL_LEGACY_MEDIA=1
# Путь к YOLOv8-ONNX (signature/stamp) внутри контейнера ml1 или на хосте.
# Пусто = детектор отключён, signature/stamp = null («проверка не выполнена»).
# YOLO_MODEL_PATH=      — печать (собственная YOLOv8n: StaVer + синтетика)
# YOLO_SIG_MODEL_PATH=  — подпись (Mels22 YOLO11s 4cls, экспорт 640: conf 0.57 на baton.png)
# YOLO_CONFIDENCE=0.4
